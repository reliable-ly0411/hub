+/* Copyright 2026. Licensed under the Apache License, Version 2.0. */
+package com.cyanogenmod.eleven.cache;
+
+import android.os.AsyncTask;
+import java.util.concurrent.ArrayBlockingQueue;
+import java.util.concurrent.ThreadPoolExecutor;
+import java.util.concurrent.TimeUnit;
+
+/** Cover work must not grow Android's shared AsyncTask pool during rapid search. */
+final class ArtworkExecutor {
+    private static final ThreadPoolExecutor POOL = new ThreadPoolExecutor(2, 2, 30,
+            TimeUnit.SECONDS, new ArrayBlockingQueue<Runnable>(32));
+    private ArtworkExecutor() { }
+    static <T> void execute(AsyncTask<T, ?, ?> task, T... args) {
+        POOL.purge();
+        task.executeOnExecutor(POOL, args);
+    }
+}
