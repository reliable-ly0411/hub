new file mode 100644
--- /dev/null
+++ b/src/com/cyanogenmod/eleven/cache/SafeArtwork.java
@@ -0,0 +1,100 @@
+/* Copyright 2026. Licensed under the Apache License, Version 2.0. */
+package com.cyanogenmod.eleven.cache;
+
+import android.content.ContentResolver;
+import android.graphics.Bitmap;
+import android.graphics.BitmapFactory;
+import android.net.Uri;
+import android.util.Log;
+import android.widget.ImageView;
+import java.io.FileInputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.util.concurrent.Semaphore;
+
+/** One boundary for untrusted cover data, including old on-disk cache entries. */
+public final class SafeArtwork {
+    public static final int MAX_EDGE = 1024;
+    private static final Semaphore DECODERS = new Semaphore(2, true);
+    public interface Source { InputStream open() throws IOException; }
+    private SafeArtwork() { }
+
+    public static int viewEdge(ImageView view) {
+        int w = view.getWidth(), h = view.getHeight();
+        if (view.getLayoutParams() != null) {
+            if (w <= 0) w = view.getLayoutParams().width;
+            if (h <= 0) h = view.getLayoutParams().height;
+        }
+        int edge = Math.max(w, h);
+        if (edge <= 0) return MAX_EDGE; // layout is not yet measured
+        int bucket = 128;
+        while (bucket < edge && bucket < MAX_EDGE) bucket <<= 1;
+        return bucket;
+    }
+
+    public static int sample(int width, int height, int requestedEdge) {
+        int edge = Math.max(1, Math.min(MAX_EDGE, requestedEdge));
+        int sample = 1;
+        // long arithmetic and ceiling division also cover extreme aspect ratios.
+        while (((long) width + sample - 1) / sample > edge
+                || ((long) height + sample - 1) / sample > edge) {
+            if (sample >= (1 << 30)) break;
+            sample <<= 1;
+        }
+        return sample;
+    }
+
+    public static Bitmap uri(final ContentResolver resolver, final Uri uri, int edge) {
+        return decode(new Source() {
+            public InputStream open() throws IOException { return resolver.openInputStream(uri); }
+        }, edge);
+    }
+
+    public static Bitmap file(final String path, int edge) {
+        return decode(new Source() {
+            public InputStream open() throws IOException { return new FileInputStream(path); }
+        }, edge);
+    }
+
+    public static Bitmap decode(Source source, int requestedEdge) {
+        boolean acquired = false;
+        try {
+            DECODERS.acquire(); acquired = true;
+            if (Thread.currentThread().isInterrupted()) return null;
+            BitmapFactory.Options options = new BitmapFactory.Options();
+            options.inJustDecodeBounds = true;
+            try (InputStream input = source.open()) {
+                if (input == null) return null;
+                BitmapFactory.decodeStream(input, null, options);
+            }
+            if (options.outWidth <= 0 || options.outHeight <= 0) return null;
+            int edge = Math.max(1, Math.min(MAX_EDGE, requestedEdge));
+            options.inSampleSize = sample(options.outWidth, options.outHeight, edge);
+            options.inJustDecodeBounds = false;
+            options.inScaled = false;
+            options.inPreferredConfig = Bitmap.Config.ARGB_8888;
+            if (Thread.currentThread().isInterrupted()) return null;
+            Bitmap bitmap;
+            try (InputStream input = source.open()) {
+                if (input == null) return null;
+                bitmap = BitmapFactory.decodeStream(input, null, options);
+            }
+            // Never send an unexpectedly large decoder result to Canvas or the cache.
+            if (bitmap != null && (bitmap.getWidth() > edge || bitmap.getHeight() > edge
+                    || bitmap.getAllocationByteCount() > (long) edge * edge * 4)) {
+                bitmap.recycle();
+                return null;
+            }
+            return bitmap;
+        } catch (InterruptedException cancelled) {
+            Thread.currentThread().interrupt();
+        } catch (IOException | RuntimeException failure) {
+            Log.w("ElevenArtwork", "Cover unavailable: " + failure.getClass().getSimpleName());
+        } catch (OutOfMemoryError failure) {
+            Log.w("ElevenArtwork", "Cover allocation failed; using placeholder");
+        } finally {
+            if (acquired) DECODERS.release();
+        }
+        return null;
+    }
+}
