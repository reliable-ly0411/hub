 /** One boundary for untrusted cover data, including old on-disk cache entries. */
 public final class SafeArtwork {
     public static final int MAX_EDGE = 1024;
+    private static final int SYSTEM_ART_EDGE = 256;
     private static final Semaphore DECODERS = new Semaphore(2, true);
     public interface Source { InputStream open() throws IOException; }
     private SafeArtwork() { }
@@ -54,6 +55,26 @@
         return decode(new Source() {
             public InputStream open() throws IOException { return new FileInputStream(path); }
         }, edge);
+    }
+
+    /** Supplies a separate, small bitmap for Android's notification and lock screen. */
+    public static Bitmap copyForSystem(Bitmap source) {
+        if (source == null || source.isRecycled()) return null;
+        int width = source.getWidth();
+        int height = source.getHeight();
+        int longEdge = Math.max(width, height);
+        // Some framework versions truncate the short edge to zero when they rescale art.
+        // An extreme panorama remains available in the app; system artwork is optional.
+        if ((long) Math.min(width, height) * 16 < longEdge) return null;
+        try {
+            if (longEdge <= SYSTEM_ART_EDGE) return source.copy(Bitmap.Config.ARGB_8888, false);
+            float scale = SYSTEM_ART_EDGE / (float) longEdge;
+            return Bitmap.createScaledBitmap(source, Math.max(1, Math.round(width * scale)),
+                    Math.max(1, Math.round(height * scale)), true);
+        } catch (IllegalArgumentException | OutOfMemoryError failure) {
+            Log.w("ElevenArtwork", "Could not prepare media card artwork");
+            return null;
+        }
     }
 
