diff --git a/src/com/cyanogenmod/eleven/utils/PublicMediaSearch.java b/src/com/cyanogenmod/eleven/utils/PublicMediaSearch.java
new file mode 100644
--- /dev/null
+++ b/src/com/cyanogenmod/eleven/utils/PublicMediaSearch.java
@@ -0,0 +1,100 @@
+/* Licensed under the Apache License, Version 2.0. */
+package com.cyanogenmod.eleven.utils;
+
+import android.content.Context;
+import android.database.Cursor;
+import android.net.Uri;
+import android.provider.BaseColumns;
+import android.provider.MediaStore.Audio.Albums;
+import android.provider.MediaStore.Audio.Artists;
+import android.provider.MediaStore.Audio.Media;
+
+import com.cyanogenmod.eleven.model.SearchResult;
+import com.cyanogenmod.eleven.model.SearchResult.ResultType;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/** Searches the public MediaStore collections on providers without the old fancy URI. */
+public final class PublicMediaSearch {
+    private PublicMediaSearch() { }
+
+    public static List<SearchResult> find(Context context, String query, ResultType type, int limit) {
+        List<SearchResult> results = new ArrayList<SearchResult>();
+        if (query == null || query.trim().isEmpty() || limit <= 0) return results;
+        Uri uri;
+        String[] projection;
+        String[] searchable;
+        String sort;
+        StringBuilder selection = new StringBuilder();
+        switch (type) {
+            case Song:
+                uri = Media.EXTERNAL_CONTENT_URI;
+                projection = new String[]{BaseColumns._ID, Media.TITLE, Media.ARTIST, Media.ALBUM,
+                        Media.ALBUM_ID};
+                searchable = new String[]{Media.TITLE, Media.ARTIST, Media.ALBUM};
+                sort = Media.DEFAULT_SORT_ORDER;
+                selection.append(Media.IS_MUSIC).append("=1");
+                break;
+            case Artist:
+                uri = Artists.EXTERNAL_CONTENT_URI;
+                projection = new String[]{BaseColumns._ID, Artists.ARTIST, Artists.NUMBER_OF_ALBUMS,
+                        Artists.NUMBER_OF_TRACKS};
+                searchable = new String[]{Artists.ARTIST};
+                sort = Artists.DEFAULT_SORT_ORDER;
+                break;
+            case Album:
+                uri = Albums.EXTERNAL_CONTENT_URI;
+                projection = new String[]{BaseColumns._ID, Albums.ALBUM, Albums.ARTIST,
+                        Albums.NUMBER_OF_SONGS};
+                searchable = new String[]{Albums.ALBUM, Albums.ARTIST};
+                sort = Albums.DEFAULT_SORT_ORDER;
+                break;
+            default:
+                return results;
+        }
+
+        List<String> arguments = new ArrayList<String>();
+        for (String word : query.trim().split("\\s+")) {
+            if (selection.length() > 0) selection.append(" AND ");
+            selection.append('(');
+            String match = "%" + word.replace("\\", "\\\\").replace("%", "\\%")
+                    .replace("_", "\\_") + "%";
+            for (int i = 0; i < searchable.length; i++) {
+                if (i > 0) selection.append(" OR ");
+                selection.append(searchable[i]).append(" LIKE ? ESCAPE '\\'");
+                arguments.add(match);
+            }
+            selection.append(')');
+        }
+
+        try (Cursor cursor = MediaStoreQuery.query(context.getContentResolver(), uri, projection,
+                selection.toString(), arguments.toArray(new String[arguments.size()]), sort)) {
+            if (cursor == null) return results;
+            while (results.size() < limit && cursor.moveToNext()) {
+                SearchResult result = new SearchResult();
+                result.mType = type;
+                result.mId = cursor.getLong(0);
+                result.mAlbumId = -1;
+                if (type == ResultType.Song) {
+                    result.mTitle = cursor.getString(1);
+                    result.mArtist = cursor.getString(2);
+                    result.mAlbum = cursor.getString(3);
+                    if (!cursor.isNull(4)) result.mAlbumId = cursor.getLong(4);
+                } else if (type == ResultType.Artist) {
+                    result.mArtist = cursor.getString(1);
+                    result.mAlbumCount = cursor.getInt(2);
+                    result.mSongCount = cursor.getInt(3);
+                } else {
+                    result.mAlbum = cursor.getString(1);
+                    result.mArtist = cursor.getString(2);
+                    result.mSongCount = cursor.getInt(3);
+                    result.mAlbumId = result.mId;
+                }
+                if (result.mTitle == null && type == ResultType.Song) continue;
+                results.add(result);
+            }
+        }
+        return results;
+    }
+}
